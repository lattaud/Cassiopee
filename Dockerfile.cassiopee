# =============================================================================
# Cassiopee build environment — MinGW-w64 toolchain + MSVC Python 3.8
# =============================================================================
FROM mcr.microsoft.com/windows/servercore:ltsc2022

SHELL ["cmd", "/S", "/C"]

# ---------------------------------------------------------------------------
# 1. Bootstrap 7za.exe (full 7-Zip console, handles tar+xz)
# ---------------------------------------------------------------------------
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command "Invoke-WebRequest -Uri 'https://www.7-zip.org/a/7za920.zip' -OutFile 'C:\7za.zip'"
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::ExtractToDirectory('C:\7za.zip', 'C:\7za_tmp')"
RUN copy C:\7za_tmp\7za.exe C:\Windows\System32\7za.exe
RUN rmdir /S /Q C:\7za_tmp
RUN del C:\7za.zip

# ---------------------------------------------------------------------------
# 2. Download and extract MSYS2 (.tar.xz, two-pass via 7za)
# ---------------------------------------------------------------------------
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command "Invoke-WebRequest -Uri 'https://github.com/msys2/msys2-installer/releases/download/2024-01-13/msys2-base-x86_64-20240113.tar.xz' -OutFile 'C:\msys2.tar.xz'"
RUN mkdir C:\extract
RUN 7za.exe x C:\msys2.tar.xz -oC:\extract
RUN del C:\msys2.tar.xz
RUN 7za.exe x C:\extract\msys2.tar -oC:\extract
RUN move C:\extract\msys64 C:\msys2
RUN rmdir /S /Q C:\extract

# ---------------------------------------------------------------------------
# 3. Initialize pacman keyring and update MSYS2 (twice)
# ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "pacman-key --init && pacman-key --populate msys2"
RUN C:\msys2\usr\bin\bash.exe -l -c "pacman -Syuu --noconfirm --ask 20"
RUN C:\msys2\usr\bin\bash.exe -l -c "pacman -Syuu --noconfirm --ask 20"

# ---------------------------------------------------------------------------
# 4. Install MinGW-w64 toolchain
# ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "pacman -S --noconfirm mingw-w64-x86_64-gcc mingw-w64-x86_64-gcc-fortran mingw-w64-x86_64-tools-git mingw-w64-x86_64-make mingw-w64-x86_64-hdf5 mingw-w64-x86_64-netcdf git"

# ---------------------------------------------------------------------------
# 5. Install MSVC Python 3.8 (3.8.10 = last release with Windows installer)
# ---------------------------------------------------------------------------
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command "Invoke-WebRequest -Uri 'https://www.python.org/ftp/python/3.8.10/python-3.8.10-amd64.exe' -OutFile 'C:\python38-installer.exe'"
RUN C:\python38-installer.exe /quiet InstallAllUsers=1 TargetDir=C:\Python38 PrependPath=0 Include_test=0 Include_doc=0
RUN del C:\python38-installer.exe

# ---------------------------------------------------------------------------
# 6. Install Python packages
# ---------------------------------------------------------------------------
RUN C:\Python38\python.exe -m pip install --upgrade pip
RUN C:\Python38\python.exe -m pip install "setuptools>=61" "wheel" "setuptools_scm>=8" "numpy>=1.23.3,<2" "scons>=4.4.0"

# ---------------------------------------------------------------------------
# 7. Generate libpython38.a (MinGW import library from MSVC DLL)
# ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "cd /c/Python38 && /mingw64/bin/gendef python38.dll && /mingw64/bin/dlltool -d python38.def -l libs/libpython38.a"

# ---------------------------------------------------------------------------
# 8. Clone Cassiopee (main branch)
# ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "git clone --depth 1 https://github.com/onera/Cassiopee.git /c/cassiopee"

# ---------------------------------------------------------------------------
# 9. Patch installBase.py and pre-create installPath.py
#    installPath.py is normally generated by Dist.writeInstallPath() which
#    parses sys.prefix — this fails under our cross-build setup. We create
#    it ourselves pointing the install root at the Cassiopee source tree.
#    PYTHONPATH=/c/cassiopee/Cassiopee then makes all modules importable.
# ---------------------------------------------------------------------------
COPY patch_installbase.py C:/patch_installbase.py
RUN C:\Python38\python.exe C:\patch_installbase.py
COPY patch_dist.py C:/patch_dist.py
RUN C:\Python38\python.exe C:\patch_dist.py

# ---------------------------------------------------------------------------
# 10. Set environment variables
#     MACHINE=win64   : new main-branch env var (replaces ELSAPROD)
#     CASSIOPEE       : source root used by Dist.py path resolution
#     PYTHONPATH      : makes built modules importable without pip install
#     PATH            : MinGW64 bin first so gcc/gfortran resolve correctly
# ---------------------------------------------------------------------------
RUN setx MACHINE win64 /M
RUN setx ELSAPROD win64 /M
RUN setx CASSIOPEE C:\cassiopee\Cassiopee /M
RUN setx PYTHONPATH C:\cassiopee\Cassiopee /M
RUN setx PATH "C:\msys2\mingw64\bin;C:\Python38;C:\Python38\Scripts;%PATH%" /M

# ---------------------------------------------------------------------------
# Helper vars used in every build RUN:
#   - export both MACHINE and ELSAPROD for compatibility
#   - call scons script directly (not python -m SCons) to avoid argv issues
# ---------------------------------------------------------------------------

# # ---------------------------------------------------------------------------
# # 11. Build KCore
# # ---------------------------------------------------------------------------

RUN C:\Python38\python.exe -m pip install delvewheel
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/KCore && /c/Python38/Scripts/scons install"
COPY patch_kcore_setup.py C:/patch_kcore_setup.py
RUN C:\Python38\python.exe C:\patch_kcore_setup.py

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/KCore && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"
# # ---------------------------------------------------------------------------
# # 12. Build remaining modules in dependency order
# # ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Converter && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Converter && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Geom && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Geom && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Transform && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Transform && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Generator && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Generator && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Post && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Post && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Initiator && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Initiator && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Connector && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Connector && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Dist2Walls && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Dist2Walls && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Distributor2 && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Distributor2 && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/RigidMotion && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/RigidMotion && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Compressor && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Compressor && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Intersector && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Intersector && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"

RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Modeler && /c/Python38/Scripts/scons install"
RUN C:\msys2\usr\bin\bash.exe -l -c "export MACHINE=win64 && export ELSAPROD=win64 && export CASSIOPEE=/c/cassiopee/Cassiopee && export PYTHONPATH=/c/cassiopee/Cassiopee && export PATH=/mingw64/bin:/c/Python38:/c/Python38/Scripts:$PATH && cd /c/cassiopee/Cassiopee/Modeler && /c/Python38/python.exe -m pip wheel --no-build-isolation . -w /c/dist"


# ---------------------------------------------------------------------------
# 13. Repair toutes les wheels (bundle les DLLs MinGW)
# ---------------------------------------------------------------------------
RUN C:\Python38\python.exe -m pip install delvewheel
RUN C:\Python38\python.exe -c "import os, subprocess, glob; [subprocess.run(['C:\\Python38\\python.exe', '-m', 'delvewheel', 'repair', '--add-path', 'C:\\msys2\\mingw64\\bin', '-w', 'C:\\dist\\repaired', whl], check=True) for whl in glob.glob('C:\\dist\\*.whl')]"



# 13. Final smoke test
# ---------------------------------------------------------------------------
RUN C:\msys2\usr\bin\bash.exe -l -c "export PYTHONPATH=/c/cassiopee/Cassiopee && /c/Python38/python.exe -c 'import KCore; import Converter; import Generator; import Geom; import Transform; import Post; print(\"All modules OK\")'"
RUN C:\msys2\usr\bin\bash.exe -l -c "export PYTHONPATH=/c/cassiopee/Cassiopee && /c/Python38/python.exe -c 'import KCore; import Converter; import Geom; import Transform; import Generator; import Post; import Initiator; import Connector; import Dist2Walls; import Distributor2; import RigidMotion; import Compressor; import Intersector; import Modeler; import Roms; print(\"All modules OK\")'"
WORKDIR C:/build

# ENTRYPOINT ["C:\\msys2\\usr\\bin\\bash.exe", "-l", "-c"]
# CMD ["export PATH=/mingw64/bin:$PATH && exec bash"]